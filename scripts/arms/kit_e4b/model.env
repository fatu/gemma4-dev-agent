# Model + adapter of the kit line (LATEST=kit in eval_dev.sh / make_submission.py / latest_diff.py): the same E4B + PLE-fix
# LoRA as ../latest_e4b/ (copied 2026-11-03), so a kit run differs from a latest E4B run only by the kit's prompt and settings.
# The adapter files are not in this repo: runs/adapters/$ADAPTER/ (gitignored), fetched from the public Kaggle dataset
#   kaggle datasets download $ADAPTER_DATASET -f adapter_config.json -f … -p runs/adapters/$ADAPTER   (eval_dev.sh does it)
MODEL_ALIAS=gemma-4-e4b-it-qat-w4a16-ct
ADAPTER=ple_fix
ADAPTER_DATASET=michi883/ple-proj-svd-r128
ADAPTER_SHA256=9ce83a7cad3d8523c14750696dca06ee1ca89f50813047ae390ee00c7f17c888
